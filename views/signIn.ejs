<% layout("/layouts/boilerplate") -%>

<div class="authModal">
    <h3 class="title" id="title">Stay<span>Nest</span></h3>

    <div class="login-container">

        <!-- SIGN IN -->
        <div id="signInBox" class="<%= activeForm === 'signup' ? 'hidden' : '' %>">

            <div class="login-header">
                <h4>Welcome Back</h4>
            </div>

            <form id="loginForm" novalidate action="/staynest/sign-in" method="POST" class="needs-validation">

                <div class="auth-input-group">
                    <label for="loginEmail">Email Address</label>
                    <input
                        type="email"
                        id="loginEmail"
                        placeholder="you@example.com"
                        name="email"
                        required
                    >
                    <span class="error-message">
                        Please enter a valid email address
                    </span>
                </div>

                <div class="auth-input-group">
                    <label for="loginPassword">Password</label>

                    <div class="password-wrapper">
                        <input
                            type="password"
                            id="loginPassword"
                            placeholder="••••••••"
                            minlength="8"
                            name="password"
                            required
                        >

                        <button
                            type="button"
                            class="toggle-btn toggle-password"
                        >
                            Show
                        </button>
                    </div>

                    <span class="error-message">
                        Password must be at least 6 characters
                    </span>
                </div>

                <div class="form-actions">

                    <label class="remember-me">
                        <input type="checkbox" id="remember">
                        <span>Remember me</span>
                    </label>

                    <a href="#" class="forgot-link">
                        Forgot password?
                    </a>

                </div>

                <button type="submit" class="submit-btn">
                    Continue
                </button>

            </form>

            <div class="login-footer">
                <p>
                    New to StayNest?
                    <a href="#" id="toSignUp">Sign up</a>
                </p>
            </div>

        </div>

        <!-- SIGN UP -->

        <div id="signUpBox" class="<%= activeForm === 'signup' ? '' : 'hidden' %>">

            <div class="login-header">
                <h2>Create your Account</h2>
                <% if (error && error.length) { %>
                <div class="auth-error">
                    <%= error[0] %>
                </div>
                <% } %>
            </div>

            <form id="signUpForm" action="/staynest/sign-up" method="POST" novalidate class="needs-validation">

                <div class="auth-input-group">
                    <label for="signUpUsername">
                        Username
                    </label>

                    <input
                        type="text"
                        id="signUpUsername"
                        placeholder="yourname"
                        name="username"
                        required
                    >

                    <span class="error-message">
                        Username must be at least 3 characters
                    </span>

                </div>

                <div class="auth-input-group">

                    <label for="signUpEmail">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="signUpEmail"
                        placeholder="you@example.com"
                        name="email"
                        required
                    >

                    <span class="error-message">
                        Please enter a valid email address
                    </span>

                </div>

                <div class="auth-input-group">

                    <label for="signUpPassword">
                        Password
                    </label>

                    <div class="password-wrapper">

                        <input
                            type="password"
                            id="signUpPassword"
                            placeholder="••••••••"
                            minlength="8"
                            name="password"
                            required
                        >

                        <button
                            type="button"
                            class="toggle-btn toggle-password"
                        >
                            Show
                        </button>

                    </div>

                    <span class="error-message">
                        Password must be at least 6 characters
                    </span>

                </div>

                <button
                    type="submit"
                    class="submit-btn"
                >
                    Create Account
                </button>

            </form>

            <div class="login-footer">
                <p>
                    Already have an account?
                    <a href="#" id="toSignIn">
                        Sign in
                    </a>
                </p>
            </div>

        </div>

    </div>
</div>