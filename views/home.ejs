<% layout("/layouts/boilerplate") -%>
    <main>

        <!-- Hero Section -->
        <section class="hero">

            <div class="hero-content">

                <span class="hero-tag">DISCOVER YOUR NEXT STAY</span>

                <h1>
                    Find places that
                    <span>feel like home.</span>
                </h1>

                <p>
                    From cozy cabins in the mountains to luxury villas by
                    the beach, find and book amazing stays around the world.
                </p>

                <div class="hero-buttons">

                    <a href="/listings" class="btn-primary">
                        Explore Listings
                    </a>

                    <button class="btn-secondary" id="howItWorks">
                        How It Works
                    </button>

                </div>

            </div>

        </section>


        <!-- Why StayNest -->
        <section class="features" id="features">

            <div class="section-heading">

                <span>WHY STAYNEST?</span>

                <h2>A better way to find your stay</h2>

                <p>
                    Everything you need to make your next trip
                    comfortable, safe and memorable.
                </p>

            </div>


            <div class="features-grid">

                <div class="feature-card">

                    <div class="feature-icon">⌂</div>

                    <h3>Handpicked Stays</h3>

                    <p>
                        Discover carefully selected properties
                        for a comfortable and memorable stay.
                    </p>

                </div>


                <div class="feature-card">

                    <div class="feature-icon">✓</div>

                    <h3>Secure Booking</h3>

                    <p>
                        Your safety and privacy are our top
                        priorities with secure booking.
                    </p>

                </div>


                <div class="feature-card">

                    <div class="feature-icon">◆</div>

                    <h3>Best Price</h3>

                    <p>
                        Find great deals and affordable stays
                        for every kind of traveler.
                    </p>

                </div>


                <div class="feature-card">

                    <div class="feature-icon">♧</div>

                    <h3>24/7 Support</h3>

                    <p>
                        We're here to help whenever you need us,
                        wherever you are.
                    </p>

                </div>

            </div>

        </section>


        <!-- CTA Section -->
        <section class="cta-section">

            <div class="cta-content">

                <span>YOUR NEXT ADVENTURE AWAITS</span>

                <h2>Ready to find your perfect stay?</h2>

                <p>
                    Explore amazing places and create unforgettable memories
                    with StayNest.
                </p>

                <a href="/listings" class="btn-primary">
                    Explore Listings
                </a>

            </div>

        </section>


        <!-- Popular Destinations -->
        <section class="destinations">

            <div class="section-heading">

                <span>EXPLORE</span>

                <h2>Popular destinations</h2>

                <p>
                    Find your next escape from some of the most
                    loved places by our travelers.
                </p>

            </div>


            <div class="destination-grid">

                <!-- Mountain -->
                <a
                    href="/listings?category=Mountain"
                    class="destination-card"
                >

                    <img
                        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=900&q=80"
                        alt="Mountain destination"
                    >

                    <div class="destination-info">

                        <h3>Mountain Retreats</h3>

                        <p>
                            Peaceful stays surrounded by nature
                        </p>

                    </div>

                </a>


                <!-- Beach -->
                <a
                    href="/listings?category=Beach"
                    class="destination-card"
                >

                    <img
                        src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80"
                        alt="Beach destination"
                    >

                    <div class="destination-info">

                        <h3>Beach Getaways</h3>

                        <p>
                            Relax by the sea and enjoy the sunshine
                        </p>

                    </div>

                </a>


                <!-- Countryside -->
                <a
                    href="/listings?category=Countryside"
                    class="destination-card"
                >

                    <img
                        src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80"
                        alt="Countryside destination"
                    >

                    <div class="destination-info">

                        <h3>Countryside Escapes</h3>

                        <p>
                            Slow down and enjoy peaceful surroundings
                        </p>

                    </div>

                </a>

            </div>

        </section>

    </main>