<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login & Signup form With Flip Animation | CodeByGaurav</title>
    <link rel="stylesheet" href="/css/sign.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <h2><span>Stay</span> Nest</h2>
    <div id="container">
      <!-- Login -->
      <div class="login">
        <div class="content">
          <h1>Log In</h1>
          <form action="/staynest/login" method="POST">
            <input type="email" name="email" placeholder="email" />
            <input type="password" name="password" placeholder="password" />
            <span class="remember">Remember me</span>
            <span class="forget">Forgot Password</span>
            <span class="clearfix"></span>
            <button type="submit">Log In</button>
          </form>

          <span class="loginwith">Or Connect with</span>

          <!-- Socials Icons -->
          <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
          <a href="#"><i class="fa-brands fa-twitter"></i></a>
          <a href="#"><i class="fa-brands fa-github"></i></a>
          <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
        </div>
      </div>

      <!-- Front Page -->
      <div class="page front">
        <div class="content">
          <!-- User Icon -->
          <i class="fa-solid fa-user-plus userIcon"></i>

          <h1>Hello, friend</h1>
          <p>Enter your personal details and start journey with us</p>

          <button class="flip-register" id="register">
            Register
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>

      <!-- Back Page -->
      <div class="page back">
        <div class="content">
          <!-- Login Icon -->
          <i class="fa-solid fa-right-to-bracket bracketIcon"></i>

          <h1>Welcome Back!</h1>
          <p>To keep connected with us please login with your personal info</p>

          <button id="login" class="login-btn">
            <i class="fa-solid fa-arrow-left"></i> Log In
          </button>
        </div>
      </div>

      <!-- Register -->
      <div class="register">
        <div class="content">
          <h1>Sign Up</h1>

          <!-- Socials icons -->
          <i class="fa-brands fa-facebook-f"></i>
          <i class="fa-brands fa-twitter"></i>
          <i class="fa-brands fa-github"></i>
          <i class="fa-brands fa-linkedin-in"></i>

          <span class="loginwith">Or</span>

          <form action="/staynest/register" method="POST">
            <input type="text" name="name" placeholder="name" />
            <input type="email" name="email" placeholder="email" />
            <input type="password" name="password" placeholder="password" />
            <span class="remember">I accept terms</span>
            <span class="clearfix"></span>
            <button type="submit">Register</button>
          </form>
        </div>
      </div>
    </div>
  </body>
  <script src="/javascript/sign.js"></script>
</html>
