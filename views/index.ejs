<% layout("/layouts/boilerplate") -%>
<div id="filters">
<div class="filter <%= selectedCategory === 'Trending' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-fire" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Trending</p>
</div>

<div class="filter <%= selectedCategory === 'Beach' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-umbrella-beach" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Beach</p>
</div>

<div class="filter <%= selectedCategory === 'Mountain' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-mountain" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Mountain</p>
</div>

<div class="filter <%= selectedCategory === 'Camping' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-tent" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Camping</p>
</div>

<div class="filter <%= selectedCategory === 'Castle' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-brands fa-fort-awesome" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Castle</p>
</div>

<div class="filter <%= selectedCategory === 'Farm' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-cow" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Farm</p>
</div>

<div class="filter <%= selectedCategory === 'Pool' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-person-swimming" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Pool</p>
</div>

<div class="filter <%= selectedCategory === 'City' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-city" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>City</p>
</div>

<div class="filter <%= selectedCategory === 'Arctic' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-snowflake" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Arctic</p>
</div>

<div class="filter <%= selectedCategory === 'Boat' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-ship" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Boat</p>
</div>

<div class="filter <%= selectedCategory === 'Homestay' ? 'active-filter' : '' %>">
    <div>
        <i class="fa-solid fa-house-chimney-user" style="color: rgb(221, 109, 71);"></i>
    </div>
    <p>Homestay</p>
</div>

<div class="tax-toggle">
    <div class="form-check form-switch form-check-reverse">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked">
        <label class="form-check-label" for="switchCheckChecked">Display Tax</label>
    </div>
</div>

</div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 mt-4">
            <%for(let list of allList){%>
                <a href="/listings/<%=list.id%>">
                <div class="card col listing-card">
                    <img src="<%=list.image.url%>" class="card-img-top" alt="anyimage" style="height: 17rem;">
                      <div class="card-img-overlay">
                      </div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%=list.title%></b>
                            <br>
                            &#8377;<%=list.price.toLocaleString("en-IN")%>/night
                            <i class="gst"> &nbsp; +18% GST</i>
                        </p>
                    </div>
                </div>
                </a>
            <%}%>
    </div>


